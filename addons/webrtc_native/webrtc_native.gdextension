; godotengine/webrtc-native 1.2.2-stable (MIT). Adds WebRTCPeerConnection on desktop
; (web exports use the browser's built-in WebRTC). Only the release libraries for the
; platforms GoKart exports are vendored; the editor/debug builds load them too.

[configuration]

entry_symbol = "webrtc_extension_init"
compatibility_minimum = 4.3

exclude_tags = ["web", "no-webrtc"]

[libraries]

linux.debug.x86_64 = "lib/libwebrtc_native.linux.template_release.x86_64.so"
linux.debug.arm64 = "lib/libwebrtc_native.linux.template_release.arm64.so"
macos.debug = "lib/libwebrtc_native.macos.template_release.universal.framework"
windows.debug.x86_64 = "lib/libwebrtc_native.windows.template_release.x86_64.dll"
windows.debug.arm64 = "lib/libwebrtc_native.windows.template_release.arm64.dll"

linux.release.x86_64 = "lib/libwebrtc_native.linux.template_release.x86_64.so"
linux.release.arm64 = "lib/libwebrtc_native.linux.template_release.arm64.so"
macos.release = "lib/libwebrtc_native.macos.template_release.universal.framework"
windows.release.x86_64 = "lib/libwebrtc_native.windows.template_release.x86_64.dll"
windows.release.arm64 = "lib/libwebrtc_native.windows.template_release.arm64.dll"
